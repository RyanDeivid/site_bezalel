# Bezalel API — variáveis de ambiente do BACKEND.
# Copie para .env (não versionado). Segredos ficam SÓ aqui, nunca no frontend.

# Origens autorizadas a chamar a API (CORS), separadas por vírgula. Nunca "*".
ALLOWED_ORIGINS=https://ryandeivid.github.io

# "production" faz os agentes aparecerem como offline/production em vez de demo.
BEZALEL_ENV=demo

# Caminho alternativo para o arquivo de dados (padrão: data/catalog.json).
# BEZALEL_DATA_FILE=/opt/bezalel/server/data/catalog.json

# Chave do provedor de LLM para o assistente (opcional). Sem ela, POST
# /v1/assistant responde 501 — o frontend continua usando as regras locais.
LLM_API_KEY=

# ---- Runtime de agentes (docs/AGENT-OPERATIONS.md) -------------------------------------------------
# Tokens: nome:papel:sha256 (gere com `python -m app.runtime.cli token <nome> <papel>`). Vazio = runtime
# fechado (503). Papéis: reader, operator, approver, admin.
BEZALEL_RUNTIME_TOKENS=
# Banco do runtime (padrão: server/var/runtime.db).
# BEZALEL_RUNTIME_DB=
# Escrita vinda da rede (só atrás de TLS e do proxy). Padrão: só da própria máquina.
# BEZALEL_RUNTIME_ALLOW_REMOTE_WRITES=1

# Provedor de modelos (opcional). Sem tudo isto, as etapas com modelo ficam "não rodou".
# BEZALEL_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# BEZALEL_LLM_MODEL=claude-sonnet-5
# BEZALEL_LLM_PRICE_IN_PER_MTOK=
# BEZALEL_LLM_PRICE_OUT_PER_MTOK=
# BEZALEL_LLM_DAILY_BUDGET_USD=0
