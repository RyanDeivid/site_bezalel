# Bezalel API — variáveis de ambiente do BACKEND.
# Copie para .env (não versionado). Segredos ficam SÓ aqui, nunca no frontend.

# Origens autorizadas a chamar a API (CORS), separadas por vírgula. Nunca "*".
ALLOWED_ORIGINS=https://ryandeivid.github.io

# "production" faz os agentes aparecerem como offline/production em vez de demo.
BEZALEL_ENV=demo

# Caminho alternativo para o arquivo de dados (padrão: data/catalog.json).
# BEZALEL_DATA_FILE=/opt/bezalel/server/data/catalog.json

# Chave do provedor de LLM para o assistente (opcional). Sem ela, POST
# /v1/assistant responde 501 — o frontend continua usando as regras locais.
LLM_API_KEY=
