{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-dist.ts 4173",
      "startServerReadyPattern": "serve-dist",
      "url": [
        "http://localhost:4173/site_bezalel/",
        "http://localhost:4173/site_bezalel/explore/",
        "http://localhost:4173/site_bezalel/course/harvard-cs50x/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 400 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
