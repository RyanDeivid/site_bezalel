# Bezalel — variáveis de ambiente do FRONTEND (Vite).
#
# ATENÇÃO: toda variável com prefixo VITE_ é embutida no JavaScript público
# enviado ao navegador. NUNCA coloque segredos aqui (chaves de API de IA,
# service_role do Supabase, tokens administrativos). Segredos pertencem
# exclusivamente ao backend (ver server/.env.example e docs/SECURITY.md).

# Caminho base da publicação. GitHub Pages de projeto: /site_bezalel/
# Domínio próprio ou desenvolvimento local: /
VITE_BASE_PATH=/

# Origem pública usada em canonical, Open Graph e sitemap (sem barra final).
VITE_SITE_ORIGIN=https://ryandeivid.github.io

# Fonte de dados: "demo" (padrão, 100% local, sem credenciais) ou "api"
# (consome o backend descrito em docs/ARCHITECTURE.md e server/).
VITE_DATA_MODE=demo

# URL pública do backend, usada apenas quando VITE_DATA_MODE=api.
# Ex.: https://api.seudominio.com
VITE_API_BASE_URL=
